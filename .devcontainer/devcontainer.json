// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "WaniKani Mobile",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:24",
	"postCreateCommand": "corepack enable && corepack prepare pnpm@11.11.0 --activate && pnpm install",
	"forwardPorts": [5173],
	"appPort": [5173],
	"runArgs": ["-p", "5173:5173"],
	"remoteUser": "node",
	"containerUser": "node",
	"customizations": {
		"jetbrains": {
			"plugins": ["dev.blachut.svelte.lang", "intellij.prettierJS"]
		}
	}
}
