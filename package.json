		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^24",
		"@types/web-push": "^3.6.4",
		"bits-ui": "^2.18.1",
		"eslint": "^10.8.0",
