		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-sonner": "^1.1.1",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
